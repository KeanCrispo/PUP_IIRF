                    <span class="menu-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M21 6H3v12h18V6zM7 10h10v4H7z"/></svg>
                    </span>
                    <span>Subscriptions</span>
