@{
    ViewData["Title"] = "Home Page";
}

<div class="youtube-container">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <img src="@(Url.Content("~/logo.png"))" alt="TubeHub logo" class="logo-img" />
                <span class="logo-text">TubeHub</span>
            </div>
        </div>
        
        <nav class="sidebar-menu">
            <div class="menu-section">
                <a href="#" class="menu-item active" data-target="pane-home">
                    <span class="menu-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
