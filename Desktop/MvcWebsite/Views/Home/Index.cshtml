<!-- video player modal -->
<div id="video-player-modal" class="video-modal" aria-hidden="true" role="dialog" aria-label="Video player">
    <div class="video-modal-content" role="document">
        <button class="video-close" aria-label="Close video">✕</button>
        <div class="player-wrapper">
            <video id="player" controls playsinline preload="metadata"></video>
            <div class="player-meta">
                <h3 id="player-title"></h3>
                <p id="player-channel"></p>
            </div>
        </div>
    </div>
