<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #121212; /* Dark background */
        color: #ffffff; /* All text white */
    }

    .youtube-container {
        display: flex;
        height: 100vh;
    }

    /* Sidebar Styles */
    .sidebar {
        width: 240px;
        background-color: #1e1e1e; /* Dark sidebar */
        border-right: 1px solid #333; /* Dark border */
        overflow-y: auto;
        padding: 16px 0;
    }

    .sidebar-header {
        padding: 0 16px 24px;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 24px;
        font-weight: 700;
        cursor: pointer;
    }

    .logo-img {
        width: 32px;
        height: 32px;
        object-fit: contain;
        border-radius: 4px; /* optional */
    }

    .logo-text {
        color: #ffffff;
    }

    .sidebar-menu {
        display: flex;
        flex-direction: column;
    }

    .menu-section {
        border-bottom: 1px solid #e0e0e0;
        padding: 8px 0;
    }

    .menu-section:last-child {
        border-bottom: none;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 10px 16px;
        color: #ffffff; /* All menu text white */
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s;
        font-size: 14px;
    }

    .menu-item:hover {
        background-color: #444; /* Dark hover */
    }

    .menu-item.active {
        background-color: #333; /* dark active background */
        color: #ffffff;
        font-weight: 500;
    }

    .menu-icon {
        font-size: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .menu-icon svg {
        width: 20px;
        height: 20px;
        fill: #ffffff; /* ensure icons are white */
        display: block;
    }

    /* Main Content */
    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    /* Top Navigation */
    .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #1e1e1e; /* Dark top navigation */
        border-bottom: 1px solid #333; /* Dark border */
        padding: 16px 24px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .search-container {
        display: flex;
        align-items: center;
        flex: 1;
        max-width: 400px;
    }

    .search-box {
        width: 100%;
        padding: 10px 16px;
        border: 1px solid #ccc;
        border-radius: 20px;
        font-size: 14px;
        background-color: #333; /* Dark input */
        color: #ffffff; /* white text */
    }

    .search-box:focus {
        outline: none;
        border-color: #1f1f1f;
        background-color: #333; /* keep dark when focused */
    }

    .search-btn {
        background: none;
        border: none;
        padding: 8px 16px;
        cursor: pointer;
        font-size: 16px;
    }

    .top-nav-icons {
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .nav-icon {
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        padding: 8px;
        border-radius: 50%;
        transition: background-color 0.2s;
    }

    /* top nav icons use white SVGs to match sidebar */
    .top-nav .nav-icon svg {
        width: 20px;
        height: 20px;
        fill: #ffffff;
        display: block;
    }
    
    .nav-icon:hover {
        background-color: #f0f0f0;
    }

    .nav-profile {
        background-color: #065fd4;
        color: white;
    }

    /* Content Area */
    .content-area {
        flex: 1;
        padding: 24px;
        background-color: #121212; /* Dark content area */
    }

    .section-header {
        margin-bottom: 24px;
    }

    .section-header h2 {
        font-size: 20px;
        font-weight: 500;
    }

    /* Video Grid */
    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
    }

    .video-card {
        cursor: pointer;
        transition: transform 0.2s;
    }

    .video-card:hover {
        transform: translateY(-4px);
    }

    .video-card:focus {
        outline: 3px solid rgba(26,115,232,0.18);
        outline-offset: 4px;
        border-radius: 8px;
    }

    .video-thumbnail {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        background-color: #000;
        /* subtle fallback gradient when image can't load */
        background-image: linear-gradient(180deg, #111 0%, #222 100%);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 12px;
    }
    .video-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        /* ensure a visible placeholder while loading */
        background: linear-gradient(180deg, #222 0%, #111 100%);
    }

    /* play overlay */
    .play-overlay {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0, 0, 0, 0.6);
        width: 52px;
        height: 52px;
        border-radius: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        opacity: 0;
        transition: opacity 0.12s ease;
    }

    .video-thumbnail:hover .play-overlay,
    .video-card:focus .play-overlay {
        opacity: 1;
    }

    .video-duration {
        position: absolute;
        bottom: 8px;
        right: 8px;
        background-color: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 4px 8px;
        border-radius: 2px;
        font-size: 12px;
        font-weight: 500;
    }

    .video-info h3 {
        font-size: 14px;
        font-weight: 500;
        color: #ffffff;
        margin-bottom: 4px;
        line-height: 1.4;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .channel-name {
        font-size: 12px;
        color: #ffffff;
        margin-bottom: 2px;
    }

    .video-stats {
        font-size: 12px;
        color: #ffffff;
    }

    /* Scrollbar Styling */
    .sidebar::-webkit-scrollbar,
    .main-content::-webkit-scrollbar {
        width: 8px;
    }

    .sidebar::-webkit-scrollbar-track,
    .main-content::-webkit-scrollbar-track {
        background: transparent;
    }

    .sidebar::-webkit-scrollbar-thumb,
    .main-content::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 4px;
    }

    .sidebar::-webkit-scrollbar-thumb:hover,
    .main-content::-webkit-scrollbar-thumb:hover {
        background: #999;
    }

    /* Pane visibility */
    .pane { display: none; }
    .pane.active { display: block; }

    /* small pane-specific styles */
    .pane-intro { color: #ffffff; margin-bottom: 12px; }
    .subscribe-list { display: flex; flex-direction: column; gap: 12px; }
    .sub-item { display: flex; gap: 12px; align-items: center; }
    .sub-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }

    .video-modal {
        position: fixed;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.65);
        z-index: 9999;
        padding: 24px;
    }
    .video-modal.open { display: flex; }
    .video-modal-content {
        background: #0f0f0f;
        border-radius: 8px;
        max-width: 1100px;
        width: 100%;
        max-height: calc(100vh - 48px);
        overflow: auto;
        padding: 12px;
        color: #fff;
        position: relative;
    }
    .video-close {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(255,255,255,0.06);
        border: none;
        color: #fff;
        font-size: 18px;
        padding: 6px 10px;
        border-radius: 4px;
        cursor: pointer;
    }
    .player-wrapper video {
        width: 100%;
        height: auto;
        max-height: 70vh;
        background: black;
        border-radius: 6px;
    }
    .player-meta { margin-top: 12px; }
    #player-title { margin: 0; font-size: 18px; }
    #player-channel { color: #ffffff; margin-top: 6px; font-size: 13px; }

    /* ensure clicking video-card is clearly interactive */
    .video-card { cursor: pointer; }
</style>

<script>
    // Switch panes inside the page based on sidebar clicks
    (function () {
        const menuItems = document.querySelectorAll('.menu-item');
        const panes = document.querySelectorAll('.pane');
        const titleEl = document.getElementById('section-title');

        function activate(targetId, menuItem) {
            panes.forEach(p => p.classList.remove('active'));
            const targetPane = document.getElementById(targetId);
            if (targetPane) targetPane.classList.add('active');

            document.querySelector('.menu-item.active')?.classList.remove('active');
            menuItem.classList.add('active');

            // Update header title
            const label = menuItem.querySelector('span:last-child')?.textContent?.trim() || '';
            titleEl.textContent = label || 'Section';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        menuItems.forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                const target = item.dataset.target;
                if (target) activate(target, item);
            });
            // allow keyboard navigation
            item.setAttribute('role', 'button');
            item.setAttribute('tabindex', '0');
            item.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    const target = item.dataset.target;
                    if (target) activate(target, item);
                }
            });
        });
    })();

    // Video player logic: open, play, close (with poster + keyboard support)
    (function () {
        const videoCards = document.querySelectorAll('.video-card');
        const modal = document.getElementById('video-player-modal');
        const player = document.getElementById('player');
        const playerTitle = document.getElementById('player-title');
        const playerChannel = document.getElementById('player-channel');
        const closeBtn = document.querySelector('.video-close');

        function openPlayer(card) {
            const src = card.dataset.src || '';
            const title = card.dataset.title || card.querySelector('h3')?.textContent || '';
            const channel = card.dataset.channel || card.querySelector('.channel-name')?.textContent || '';
            const poster = card.dataset.poster || card.querySelector('img')?.src || '';

            if (!src) return;

            player.pause();
            player.src = src;
            player.load();
            playerTitle.textContent = title;
            playerChannel.textContent = channel;

            modal.classList.add('open');
            document.body.style.overflow = 'hidden';
            setTimeout(() => {
                player.play().catch(err => {
                    console.warn('Error attempting to play:', err);
                });
            }, 100);
        }

        function closePlayer() {
            modal.classList.remove('open');
            document.body.style.overflow = '';
            player.pause();
            player.src = ''; // reset source
        }

        videoCards.forEach(card => {
            card.addEventListener('click', () => openPlayer(card));
        });

        closeBtn.addEventListener('click', closePlayer);

        // Close modal on outside click
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closePlayer();
        });

        // Keyboard navigation for video player
        modal.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closePlayer();
        });
    })();
</script>
